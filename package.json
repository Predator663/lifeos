{
  "name": "lifeos",
  "version": "1.1.0",
  "description": "LifeOS \u2014 a local-first personal command center: tasks, calendar, finance, habits, notes.",
  "main": "electron/main.cjs",
  "author": "Bert",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "electron-builder install-app-deps",
    "dev": "concurrently -k \"vite\" \"electron .\"",
    "build:renderer": "vite build",
    "build": "npm run build:renderer && electron-builder",
    "dist:win": "npm run build:renderer && electron-builder --win",
    "build:android": "vite build && cap sync android",
    "android:apk": "npm run build:android && cd android && gradlew.bat assembleDebug",
    "android:release": "npm run build:android && cd android && gradlew.bat assembleRelease",
    "android:bundle": "npm run build:android && cd android && gradlew.bat bundleRelease",
    "test:db": "node scripts/test-native-db.mjs",
    "test:api": "node scripts/check-api-parity.mjs",
    "test": "npm run test:db && npm run test:api"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@capawesome/capacitor-file-picker": "^8.1.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/syne": "^5.3.0",
    "auto-launch": "^5.0.6",
    "better-sqlite3": "^11.3.0",
    "date-fns": "^3.6.0",
    "framer-motion": "^11.3.24",
    "lucide-react": "^0.417.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7",
    "sql.js": "^1.14.2",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3",
    "vite": "^5.3.5"
  },
  "build": {
    "appId": "com.bert.lifeos",
    "productName": "LifeOS",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
